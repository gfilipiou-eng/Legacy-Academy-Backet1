{
    "buildCommand": "npm --prefix legacy-academy-frontend run build",
    "outputDirectory": "legacy-academy-frontend/dist",
    "installCommand": "npm --prefix legacy-academy-frontend install",
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Cross-Origin-Opener-Policy",
                    "value": "same-origin-allow-popups"
                },
                {
                    "key": "Cross-Origin-Embedder-Policy",
                    "value": "unsafe-none"
                }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
